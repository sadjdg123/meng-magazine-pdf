          "2,200–3,500"
        ],
        [
          "泉州＋厦门",
          "2,500–4,000",
          "1,800–3,240",
          "900–1,600"
        ],
        [
          "广州",
          "2,000–3,600",
          "2,250–3,600",
          "700–1,200"
        ]
      ],
      "widths": [
        1.12,
        1.05,
        1.05,
        1.05
      ]
